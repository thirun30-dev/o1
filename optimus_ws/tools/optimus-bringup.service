[Unit]
Description=Optimus AMR Unified Physical Robot Bringup (Drivetrain, RPLIDAR, rosbridge, System Manager)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dk
WorkingDirectory=/home/dk/optimus_ws
Environment="HOME=/home/dk"
Environment="PYTHONUNBUFFERED=1"
# Same as typing "optimus": certificate check + bringup with wss:// rosbridge
ExecStart=/home/dk/optimus_ws/tools/optimus
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
