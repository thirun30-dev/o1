<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Optimus body: 600 x 400 x 300 mm box carried by two ZLTECH hub motors
    in the middle and four corner casters. The RPLidar sits on top at the
    front; a storage container occupies the rest of the top deck.

    Coordinate convention:
      X: forward
      Y: left
      Z: up

    base_link is located at the center of the robot footprint.
    The chassis is centered above base_link.
  -->

  <xacro:property name="chassis_length" value="0.60"/>
  <xacro:property name="chassis_width" value="0.40"/>
  <xacro:property name="chassis_height" value="0.30"/>

  <!-- Storage container on the top deck, behind the LiDAR.
       MEASURE: footprint and height. Must stay below the LiDAR scan plane
       (lidar_z in sensors/lidar.xacro) for the 360-degree scan to be clear. -->
  <xacro:property name="container_length" value="0.40"/>
  <xacro:property name="container_width" value="0.34"/>
  <xacro:property name="container_height" value="0.025"/>
  <xacro:property name="container_x" value="-0.07"/>

  <!-- TODO:
       Replace with verified physical mass when available.
  -->
  <xacro:property name="chassis_mass" value="0.1"/>

  <!-- BASE LINK -->

  <link name="base_link"/>

  <!-- CHASSIS -->

  <joint
    name="chassis_joint"
    type="fixed">

    <parent link="base_link"/>
    <child link="chassis"/>

    <!-- Chassis center is half its height above ground plane -->
    <origin
      xyz="0 0 ${chassis_height / 2.0}"
      rpy="0 0 0"/>

  </joint>


  <link name="chassis">

    <visual>

      <geometry>
        <box
          size="${chassis_length}
                ${chassis_width}
                ${chassis_height}"/>
      </geometry>

      <material name="white"/>

    </visual>


    <collision>

      <geometry>
        <box
          size="${chassis_length}
                ${chassis_width}
                ${chassis_height}"/>
      </geometry>

    </collision>


    <xacro:inertial_box
      mass="${chassis_mass}"
      x="${chassis_length}"
      y="${chassis_width}"
      z="${chassis_height}">

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

    </xacro:inertial_box>

  </link>


  <gazebo reference="chassis">
    <material>Gazebo/White</material>
  </gazebo>


  <!-- STORAGE CONTAINER (visual only, so it never clips simulated LiDAR rays) -->

  <joint name="storage_container_joint" type="fixed">
    <parent link="base_link"/>
    <child link="storage_container"/>
    <origin xyz="${container_x} 0 ${chassis_height + container_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="storage_container">
    <visual>
      <geometry>
        <box size="${container_length} ${container_width} ${container_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <gazebo reference="storage_container">
    <material>Gazebo/Orange</material>
  </gazebo>

</robot>