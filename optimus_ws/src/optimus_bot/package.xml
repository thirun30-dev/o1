<?xml version="1.0"?>
<package format="3">
  <name>optimus_bot</name>
  <version>0.1.0</version>
  <description>Optimus robot integration package for ros2_control, SLAM Toolbox and Nav2.</description>
  <maintainer email="letsmaildilip@gmail.com">dk</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <!-- Gazebo Classic on Humble; Gazebo Sim (Harmonic) on newer distros. -->
  <exec_depend condition="$ROS_DISTRO == humble">gazebo_ros</exec_depend>
  <exec_depend condition="$ROS_DISTRO == humble">gazebo_ros2_control</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">ros_gz_sim</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">ros_gz_bridge</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">gz_ros2_control</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>zlac_drive</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <!-- Obstacle camera: OpenCV for the laptop/USB webcam, camera_ros (libcamera) for the Pi camera. -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>camera_ros</exec_depend>
  <!-- Depth camera driver profiles + depth obstacle node (depth_camera:=...). -->
  <exec_depend>optimus_depth</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Used by the system/location managers, launch files and the dashboard bridge. -->
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
