<?xml version="1.0"?>
<!-- Optimus AMR - geometry mirrors the real robot model in optimus_bot
     (config/drivetrain.yaml, description/base, wheels, sensors):
     600 x 400 x 300 mm body above the wheel axle, 2 x ZLLG50ASM200 hub motors
     (131 mm wheels, 265 mm apart) in the middle, 4 corner casters, storage
     container on the top deck, RPLidar A1M8 on top at the front (360 deg). -->
<robot name="optimus">

  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="orange"><color rgba="0.95 0.45 0.05 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- ground-level frame used by Nav2 -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.0655" rpy="0 0 0"/>   <!-- base_link at wheel axle height (wheel radius) -->
  </joint>

  <!-- body: 0.60 x 0.40 x 0.30 m, from axle height up (optimus_bot base.xacro) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15"/><geometry><box size="0.6 0.4 0.3"/></geometry><material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15"/><geometry><box size="0.6 0.4 0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.12"/><mass value="18.0"/>
      <inertia ixx="0.375" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.78"/>
    </inertial>
  </link>

  <!-- storage container on the top deck: 0.40 x 0.34 x 0.025 m, top at 0.325 m (below the scan plane) -->
  <joint name="container_joint" type="fixed">
    <parent link="base_link"/><child link="container_link"/><origin xyz="-0.07 0 0.3125"/>
  </joint>
  <link name="container_link">
    <visual><geometry><box size="0.40 0.34 0.025"/></geometry><material name="orange"/></visual>
    <inertial><mass value="0.5"/><inertia ixx="0.0048" ixy="0" ixz="0" iyy="0.0067" iyz="0" izz="0.0115"/></inertial>
  </link>

  <!-- hub motor wheels: radius 0.0655 m, width 0.05 m, at +/- wheel_separation / 2 = 0.1325 m.
       Rolling -90 deg points both axes along +y, so positive spin drives forward. -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.1325 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="left_wheel">
    <visual><geometry><cylinder radius="0.0655" length="0.05"/></geometry><material name="grey"/></visual>
    <collision><geometry><cylinder radius="0.0655" length="0.05"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.00320" ixy="0" ixz="0" iyy="0.00320" iyz="0" izz="0.00536"/></inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.1325 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="right_wheel">
    <visual><geometry><cylinder radius="0.0655" length="0.05"/></geometry><material name="grey"/></visual>
    <collision><geometry><cylinder radius="0.0655" length="0.05"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.00320" ixy="0" ixz="0" iyy="0.00320" iyz="0" izz="0.00536"/></inertial>
  </link>

  <!-- 4 corner casters: 30 mm radius at (+/-0.25, +/-0.175) like the real model,
       frictionless, resting on the floor (centre one radius above it) -->
  <joint name="caster_fl_joint" type="fixed"><parent link="base_link"/><child link="caster_fl"/><origin xyz="0.25 0.175 -0.0355"/></joint>
  <joint name="caster_fr_joint" type="fixed"><parent link="base_link"/><child link="caster_fr"/><origin xyz="0.25 -0.175 -0.0355"/></joint>
  <joint name="caster_rl_joint" type="fixed"><parent link="base_link"/><child link="caster_rl"/><origin xyz="-0.25 0.175 -0.0355"/></joint>
  <joint name="caster_rr_joint" type="fixed"><parent link="base_link"/><child link="caster_rr"/><origin xyz="-0.25 -0.175 -0.0355"/></joint>
  <link name="caster_fl"><collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="3.6e-5" ixy="0" ixz="0" iyy="3.6e-5" iyz="0" izz="3.6e-5"/></inertial></link>
  <link name="caster_fr"><collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="3.6e-5" ixy="0" ixz="0" iyy="3.6e-5" iyz="0" izz="3.6e-5"/></inertial></link>
  <link name="caster_rl"><collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="3.6e-5" ixy="0" ixz="0" iyy="3.6e-5" iyz="0" izz="3.6e-5"/></inertial></link>
  <link name="caster_rr"><collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="3.6e-5" ixy="0" ixz="0" iyy="3.6e-5" iyz="0" izz="3.6e-5"/></inertial></link>

  <!-- RPLidar A1M8 on top, front: (0.24, 0, 0.34) as in optimus_bot lidar.xacro.
       The scan plane must stay above the container top (0.325 m) or the
       LiDAR sees the robot itself. -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/><origin xyz="0.24 0 0.34"/>
  </joint>
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="grey"/></visual>
    <inertial><mass value="0.2"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>

  <!-- ===================== Gazebo (Harmonic) ===================== -->
  <gazebo reference="left_wheel"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="caster_fl"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="caster_fr"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="caster_rl"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="caster_rr"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.265</wheel_separation>
      <wheel_radius>0.0655</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="rplidar_a1" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>
</robot>
